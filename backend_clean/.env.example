# .env.example
# 复制此文件为 .env，并填入真实的值
# 注意：.env 文件绝对不能提交到 Git！

# Flask 安全密钥（随机长字符串，例如用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=请替换为随机生成的长字符串

# MySQL 数据库配置（密码勿提交到 Git）
DB_USER=root
DB_PASS=your-db-password
DB_HOST=localhost
DB_NAME=heritage_db

# 讯飞星火大模型（必填才能对话；无仓库内默认值）
SPARK_APPID=your-appid
SPARK_API_SECRET=your-secret
SPARK_API_KEY=your-apikey

# 高德地图（必填才能定位/周边检索；无仓库内默认值）
AMAP_API_KEY=your-amap-key
# 仅 IP 定位全部失败时的兜底城市（默认广州市；正常情况按访问者公网 IP 定位）
# DEFAULT_MAP_CITY=广州市

# 智谱 AI（文生图 + 图像理解双模型串联）
# 用于「非遗数字焕新」功能：GLM-4V 识别参考图 → CogView-4 生成焕新图
ZHIPU_API_KEY=your-apikey
# 文生图模型: cogview-4-250304（推荐）, cogview-4, cogview-3-flash（免费）, glm-image
ZHIPU_IMAGE_MODEL=cogview-4-250304
# 视觉理解模型: glm-4v（支持base64）, glm-4v-plus, glm-4.6v
ZHIPU_VISION_MODEL=glm-4v

# 识图/视频溯源最多返回地标数（默认 10）
# SOURCE_TRACE_MAX_MARKERS=10

# 地图标点简介：spark=讯飞星火（默认）| qwen=百炼 Qwen3 Max
MARKER_INTRO_PROVIDER=spark
# 阿里云百炼（视频识图必填；标点简介 MARKER_INTRO_PROVIDER=qwen 时需配置）
# DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VIDEO_MODEL=qwen-vl-plus
# QWEN_INTRO_MODEL=qwen3-max

# 演示模式：true 时焕新/识图/Agent 对话走预置数据，不调用外部 API（现场答辩推荐）
# DEMO_MODE=false
# DEMO_MODE=true 时，接口返回前等待秒数（默认 3，0 表示立即返回）
# DEMO_MODE=false 时，识图/焕新命中内存缓存后也会按此秒数假装加载
# DEMO_SIMULATE_DELAY_SEC=3
