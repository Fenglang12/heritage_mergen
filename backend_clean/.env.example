# .env.example
# 复制此文件为 .env，并填入真实的值
# 注意：.env 文件绝对不能提交到 Git！

# Flask 安全密钥（随机长字符串，例如用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=请替换为随机生成的长字符串

# MySQL 数据库配置（密码勿提交到 Git）
DB_USER=root
DB_PASS=your-db-password
DB_HOST=localhost
DB_NAME=heritage_db

# 讯飞星火大模型（必填才能对话；无仓库内默认值）
SPARK_APPID=your-appid
SPARK_API_SECRET=your-secret
SPARK_API_KEY=your-apikey
# SPARK_URL=wss://spark-api.xf-yun.com/v3.1/chat
# SPARK_DOMAIN=generalv3
# Ultra 示例：SPARK_URL=wss://spark-api.xf-yun.com/v4.0/chat  SPARK_DOMAIN=4.0Ultra

# 语音听写大模型（中英）V2.0（可选；未填则回落到上面的 SPARK_*）
# 控制台「语音听写大模型」需开通并领取免费额度；domain 固定 spark_asr_v2
# IAT_APPID=your-iat-appid
# IAT_API_SECRET=your-iat-secret
# IAT_API_KEY=your-iat-apikey
# IAT_URL=wss://iat.cn-huabei-1.xf-yun.com/v1
# IAT_DOMAIN=spark_asr_v2

# 高德地图（必填才能定位/周边检索；无仓库内默认值）
AMAP_API_KEY=your-amap-key
# 仅 IP 定位全部失败时的兜底城市（默认广州市；正常情况按访问者公网 IP 定位）
# DEFAULT_MAP_CITY=广州市

# 智谱 AI（文本 / 视觉；生图备用通道）
ZHIPU_API_KEY=your-apikey
# 备用文生图: cogview-3-flash（免费）| cogview-4-250304 | glm-image
ZHIPU_IMAGE_MODEL=cogview-3-flash
# 视觉理解模型: glm-4.1v-thinking-flash（免费，支持图片/视频）, glm-4.6v-flash（免费，高峰限流）
ZHIPU_VISION_MODEL=glm-4.1v-thinking-flash

# 焕新生图主通道：qwen（百炼真图生图）| zhipu（智谱文生图）
ART_IMAGE_PROVIDER=qwen
# 百炼图像模型：qwen-image-3.0（推荐）| qwen-image-3.0-pro | qwen-image-2.1-turbo
QWEN_IMAGE_MODEL=qwen-image-3.0
# QWEN_IMAGE_SIZE=1024x1024

# 识图/视频溯源最多返回地标数（默认 10）
# SOURCE_TRACE_MAX_MARKERS=10

# 地图标点简介：zhipu | qwen | spark
MARKER_INTRO_PROVIDER=zhipu
# ZHIPU_INTRO_MODEL=glm-4-flash
# QWEN_INTRO_MODEL=qwen3-max
# 视频识图通道（可指向智谱等 OpenAI 兼容服务；留空则回落到百炼 DASHSCOPE_*）
# VIDEO_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VIDEO_API_KEY=your-zhipu-apikey
# VIDEO_MODEL=glm-4.1v-thinking-flash

# 阿里云百炼（焕新 Qwen-Image / 视频备用 / 标点简介 qwen 时需配置）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_INTRO_MODEL=qwen3-max

# 演示模式
# DEMO_MODE=false
# DEMO_SIMULATE_DELAY_SEC=3
# DEMO_SIMULATE_DELAY_SEC=3
